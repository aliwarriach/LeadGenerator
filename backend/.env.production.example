# Config for the operator machine in the deployed setup: the API and UI run on
# Cloud Run, and THIS machine runs the dispatcher, the ARQ worker, and the
# scrapers. Copy to `.env.production` (gitignored) and fill in real values.
#
# Loaded via ENV_FILE=.env.production — see get_settings() in app/core/config.py.
# `backend/scripts/worker-prod.ps1` sets that for you.

ENVIRONMENT=production

# Reached through the Cloud SQL Auth Proxy, which worker-prod.ps1 starts on
# port 5433 — 5432 is already taken by the local Postgres install.
#
# 127.0.0.1, never "localhost": localhost resolves to ::1 (IPv6) first on this
# machine, so an IPv4-only listener hangs instead of failing fast.
DATABASE_URL=postgresql+asyncpg://leadgen:CHANGEME@127.0.0.1:5433/lead_generator
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# Local Redis (Memurai), unchanged from local development. The deployed API
# never touches it — the dispatcher is what bridges the two sides.
REDIS_URL=redis://127.0.0.1:6379/0

# This side owns the queue, so it uses the normal ARQ path. Only the Cloud Run
# deployment sets DISPATCH_MODE=db.
DISPATCH_MODE=queue

# The dispatcher and worker are started explicitly (three separate windows), so
# nothing here should spawn a second worker of its own.
AUTO_START_ARQ_WORKER=false

# Headed Chromium from a residential IP — the whole reason scraping stays on
# this machine rather than moving to the cloud.
SCRAPER_HEADLESS=false

# Copy these from backend/.env. GROQ_API_KEY is deliberately absent: Groq is
# only called by the audit/chat/outreach endpoints, which run in the cloud, and
# never by the worker's enrichment pipeline.
SERPER_API_KEY=
PAGESPEED_API_KEY=

# Cloud SQL instance connection name (project:region:instance) — read by
# worker-prod.ps1 to start the Auth Proxy.
CLOUD_SQL_CONNECTION_NAME=
