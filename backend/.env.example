APP_NAME=Lead Generator API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/lead_generator
DB_ECHO=false

# Use 127.0.0.1 rather than localhost — on machines where localhost resolves
# to ::1 (IPv6) first, connections hang/timeout if the server (e.g. Memurai
# on Windows) only binds the IPv4 loopback.
REDIS_URL=redis://127.0.0.1:6379/0

# JSON array — defaults to the Vite dev server if unset
# CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

SCRAPER_HEADLESS=false
SCRAPER_MAX_RESULTS=50
SCRAPER_MAX_RETRIES=3
# SCRAPER_PROXY_SERVER=http://host:port
# SCRAPER_PROXY_USERNAME=
# SCRAPER_PROXY_PASSWORD=

# SERPER_API_KEY=your-serper-dev-key

# PAGESPEED_API_KEY=your-google-api-key
# HUNTER_API_KEY=your-hunter-io-key
# OPENCORPORATES_API_KEY=your-opencorporates-key
WAPPALYZER_ENABLED=true
