APP_NAME=Lead Generator API
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/lead_generator
DB_ECHO=false

# Use 127.0.0.1 rather than localhost — on machines where localhost resolves
# to ::1 (IPv6) first, connections hang/timeout if the server (e.g. Memurai
# on Windows) only binds the IPv4 loopback.
REDIS_URL=redis://127.0.0.1:6379/0

# JSON array. Defaults to the Vite dev server ports in ENVIRONMENT=development
# only; any other environment defaults to no cross-origin access at all unless
# this is set explicitly (a same-origin deployment needs it unset).
# CORS_ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ---- Authentication / authorization -------------------------------------
# Both unset (the default) disables auth entirely — allowed ONLY when
# ENVIRONMENT=development. Any other environment refuses to start without
# credentials rather than serving every endpoint publicly.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# Role carried by the credential above: owner | operator | viewer
# BASIC_AUTH_ROLE=owner

# Extra accounts with their own roles, as a JSON array. This is how you hand
# out read-only access without granting write:
# AUTH_ACCOUNTS=[{"username":"analyst","password":"...","role":"viewer"}]

# Role used when no credentials are configured (dev/tests only). Set to
# "viewer" locally to exercise a lower-privilege path.
# UNAUTHENTICATED_ROLE=owner

# Passwords shorter than this log a startup warning (they do not block boot).
# MIN_AUTH_PASSWORD_LENGTH=12

# Security response headers. The default CSP matches what the built SPA loads
# (own hashed JS/CSS + Google Fonts) — change it if the frontend adds an
# external origin.
# SECURITY_HEADERS_ENABLED=true
# CONTENT_SECURITY_POLICY=

SCRAPER_HEADLESS=false
SCRAPER_MAX_RESULTS=50
SCRAPER_MAX_RETRIES=3
# SCRAPER_PROXY_SERVER=http://host:port
# SCRAPER_PROXY_USERNAME=
# SCRAPER_PROXY_PASSWORD=

# SERPER_API_KEY=your-serper-dev-key

# PAGESPEED_API_KEY=your-google-api-key
# HUNTER_API_KEY=your-hunter-io-key
# OPENCORPORATES_API_KEY=your-opencorporates-key
WAPPALYZER_ENABLED=true

# Caps on every Groq-backed endpoint (audit, chat, outreach x3) — see
# SecurityIssues.md M-5.
# GROQ_MAX_TOKENS=2048
# LLM_RATE_LIMIT_PER_HOUR=200
